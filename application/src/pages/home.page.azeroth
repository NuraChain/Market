import type { Category } from '../api.ts';
import { pageOf } from '../lib/paged.ts';

import { useLocale } from '../stores/locale.store.ts';
import { useMarkets } from '../stores/markets.store.ts';

import CategoryRail from '../components/market/category-rail.component.azeroth';
import MarketCard from '../components/market/market-card.component.azeroth';
import FeaturedRail from '../components/market/featured-rail.component.azeroth';
import Skeleton from '../components/ui/skeleton.component.azeroth';
import Button from '../components/ui/button.component.azeroth';
import Pagination from '../components/ui/pagination.component.azeroth';
import EmptyState from '../components/ui/empty-state.component.azeroth';
import { MARKET_GRID } from '../components/ui/variants.ts';

const PAGE_SIZE = 12;

export default component Home()
{
    const { t } = useLocale();
    const markets = useMarkets();

    state category: Category | 'all' = 'all';
    state page = 1;

    derived all = markets.data() ?? [];
    derived featured = all.filter((market) => market.featured);
    derived matching = all.filter((market) => category === 'all' || market.category === category);
    derived paged = pageOf(matching, page, PAGE_SIZE);

    <section class="shell py-5">
        <Show when={ markets.loading() }>
            <div class="mb-8 flex gap-4 overflow-hidden">
                <Skeleton class="h-64 w-[19.5rem] shrink-0 rounded-card sm:w-[22rem]" />
                <Skeleton class="h-64 w-[19.5rem] shrink-0 rounded-card sm:w-[22rem]" />
                <Skeleton class="h-64 w-[19.5rem] shrink-0 rounded-card sm:w-[22rem]" />
            </div>
            <div class={ MARKET_GRID }>
                <Skeleton class="h-44 rounded-card" />
                <Skeleton class="h-44 rounded-card" />
                <Skeleton class="h-44 rounded-card" />
                <Skeleton class="h-44 rounded-card" />
            </div>
        </Show>

        <Show when={ !markets.loading() && markets.error() !== null }>
            <EmptyState icon="alert" tone="danger" hint={ t('common.error') }>
                <Button variant="outline" onClick={ () => markets.refetch() }>{ t('common.retry') }</Button>
            </EmptyState>
        </Show>

        <Show when={ markets.data() !== undefined }>
            <FeaturedRail markets={ featured } />

            <h2 class="mb-3 text-lg font-bold tracking-tight">{ t('home.allMarkets') }</h2>
            <div class="mb-3">
                <CategoryRail selected={ category } onSelect={ (next) => { category = next; page = 1; } } />
            </div>

            <Show
                when={ paged.rows.length > 0 }
                fallback={
                    <EmptyState icon="search" title={ t('browse.noResults') } hint={ t('browse.noResultsHint') }>
                        <Button variant="outline" icon="flame" onClick={ () => category = 'all' }>{ t('categories.all') }</Button>
                    </EmptyState>
                }
            >
                <div class={ MARKET_GRID }>
                    <For each={ paged.rows } key={ (market) => market.id }>
                        { (market) => <MarketCard market={ market } /> }
                    </For>
                </div>
                <div class="mt-6">
                    <Pagination page={ paged.current } pages={ paged.pages } onChange={ (next) => page = next } />
                </div>
            </Show>
        </Show>
    </section>
}
