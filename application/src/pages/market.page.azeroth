import { useParams } from 'azerothjs';
import { client, RANGES, type Range, type Side } from '../api.ts';

import { CATEGORY_ICON, isBinary } from '../lib/market.ts';
import { pageOf } from '../lib/paged.ts';

import { useLocale } from '../stores/locale.store.ts';
import { useMarkets } from '../stores/markets.store.ts';
import { useChrome } from '../stores/chrome.store.ts';
import { useToasts } from '../stores/toasts.store.ts';

import { formatPercent, formatPrice, formatVolume, formatDateTime, formatTimeAgo } from '../i18n/format.ts';

import Icon from '../icons/icon.component.azeroth';

import Tooltip from '../components/ui/tooltip.component.azeroth';
import Chart from '../components/ui/chart.component.azeroth';
import Ticker from '../components/ui/ticker.component.azeroth';
import Badge from '../components/ui/badge.component.azeroth';
import Tabs from '../components/ui/tabs.component.azeroth';
import Sheet from '../components/ui/sheet.component.azeroth';
import Skeleton from '../components/ui/skeleton.component.azeroth';
import MarketCard from '../components/market/market-card.component.azeroth';
import TradeTicket from '../components/market/trade-ticket.component.azeroth';
import FavoriteButton from '../components/market/favorite-button.component.azeroth';
import OutcomePair from '../components/market/outcome-pair.component.azeroth';
import Pagination from '../components/ui/pagination.component.azeroth';
import Card from '../components/ui/card.component.azeroth';
import SkeletonList from '../components/ui/skeleton-list.component.azeroth';
import PillGroup from '../components/ui/pill-group.component.azeroth';
import { cardClass } from '../components/ui/variants.ts';

export default component MarketPage()
{
    const { t, lang, text } = useLocale();
    const params = useParams();
    const allMarkets = useMarkets();
    const chrome = useChrome();

    const requestConnect = (): void =>
    {
        tradeOpen = false;
        chrome.openAuth();
    };

    const toasts = useToasts();

    const share = (): void =>
    {
        void navigator.clipboard?.writeText(location.href);
        toasts.push('info', t('toast.linkCopied'), 'copy');
    };

    resource market = (id: string) => client.markets.one({ params: { id } }) with { source: params()['id'] };

    state side: Side = 'yes';
    state chosenOutcomeId = '';
    state range: Range = '1w';
    state tab = 'activity';
    state rulesOpen = false;
    state tradeOpen = false;

    derived outcomes = market.data()?.outcomes ?? [];
    derived outcome = outcomes.find((candidate) => candidate.id === chosenOutcomeId) ?? outcomes[0];
    derived seriesKey = market.data() !== undefined && outcome !== undefined
        ? `${ market.data()!.id }|${ outcome.id }|${ range }`
        : false as const;

    resource series = (key: string) =>
    {
        const [id = '', outcomeId = '', activeRange = '1w'] = key.split('|');
        return client.markets.series({ params: { id }, query: { outcome: outcomeId, range: activeRange as Range } });
    } with { source: seriesKey };

    resource activity = (id: string) => client.markets.activity({ params: { id } })
        with { source: tab === 'activity' ? params()['id'] : false };
    resource comments = (id: string) => client.markets.comments({ params: { id } })
        with { source: tab === 'comments' ? params()['id'] : false };
    resource holders = (id: string) => client.markets.holders({ params: { id } })
        with { source: tab === 'holders' ? params()['id'] : false };

    derived related = (allMarkets.data() ?? [])
        .filter((candidate) => candidate.category === market.data()?.category && candidate.id !== market.data()?.id)
        .slice(0, 6);

    state activityPage = 1;
    state commentsPage = 1;
    state holdersPage = 1;

    derived activityView = pageOf(activity.data() ?? [], activityPage, 10);
    derived commentsView = pageOf(comments.data() ?? [], commentsPage, 10);
    derived holdersView = pageOf(holders.data() ?? [], holdersPage, 10);

    <section class="shell py-5">
        <Show when={ market.loading() }>
            <Skeleton class="mb-4 h-9 max-w-xl rounded-control" />
            <div class="grid grid-cols-1 gap-4 lg:grid-cols-[1fr_21rem]">
                <Skeleton class="h-72 rounded-card" />
                <Skeleton class="h-72 rounded-card" />
            </div>
        </Show>

        <Show when={ market.data() }>
            { (data) =>
                <Show when={ outcome }>
                    { (lead) =>
                        <div>
                            <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-[minmax(0,1fr)_21rem]">
                                <div class="min-w-0">
                                    <header class="mb-4 motion-safe:animate-rise">
                                        <div class="mb-2 flex items-center gap-2 text-[13px] text-muted">
                                            <Badge tone="muted" icon={ CATEGORY_ICON[data().category] }>{ t(`categories.${ data().category }`) }</Badge>
                                            <span class="nums flex min-w-0 items-center gap-1 truncate"><Icon name="clock" size={ 13 } class="shrink-0" />{ t('market.resolves') } { formatDateTime(data().endsAt, lang()) }</span>
                                            <span class="ms-auto flex gap-1">
                                                <FavoriteButton marketId={ data().id } size="md" />
                                                <Tooltip label={ t('market.share') }>
                                                    <button class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-control text-muted transition-colors duration-200 hover:bg-overlay hover:text-text" type="button" aria-label={ t('market.share') } onClick={ () => share() }>
                                                        <Icon name="share" size={ 17 } />
                                                    </button>
                                                </Tooltip>
                                            </span>
                                        </div>
                                        <div class="flex items-start gap-3">
                                            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-card bg-overlay text-2xl" aria-hidden="true">{ data().emoji }</span>
                                            <h1 class="text-xl font-bold leading-snug sm:text-2xl">{ text(data().title) }</h1>
                                        </div>
                                        <div class="mt-3 flex items-center gap-4">
                                            <p class="text-3xl font-bold text-brand"><Ticker text={ formatPercent(lead().price, lang()) } value={ lead().price } /></p>
                                            <Badge tone={ lead().change24h >= 0 ? 'yes' : 'no' } icon={ lead().change24h >= 0 ? 'trending-up' : 'trending-down' }>
                                                <span class="latin-nums" dir="ltr">{ (lead().change24h >= 0 ? '+' : '') + lead().change24h.toFixed(1) }</span>
                                            </Badge>
                                            <span class="nums ms-auto flex items-center gap-1 text-[13px] text-faint"><Icon name="volume" size={ 14 } />{ formatVolume(data().volume, lang()) }</span>
                                        </div>
                                    </header>

                                    <Card animate="rise" class="mb-5">
                                        <div class="mb-3 flex items-center justify-between gap-2">
                                            <Show when={ !isBinary(data()) }>
                                                <div class="rail gap-1.5">
                                                    <For each={ outcomes } key={ (entry) => entry.id }>
                                                        { (entry) =>
                                                            <button
                                                                class={ lead().id === entry.id
                                                                    ? 'h-8 shrink-0 cursor-pointer rounded-full bg-text px-3 text-[12px] font-bold text-surface'
                                                                    : 'h-8 shrink-0 cursor-pointer rounded-full border border-line px-3 text-[12px] font-semibold text-muted transition-colors duration-200 hover:text-text' }
                                                                type="button"
                                                                onClick={ () => chosenOutcomeId = entry.id }
                                                            >
                                                                { text(entry.label) }
                                                            </button>
                                                        }
                                                    </For>
                                                </div>
                                            </Show>
                                            <PillGroup
                                                items={ [...RANGES].map((entry) => ({ id: entry, label: entry })) }
                                                active={ range }
                                                onChange={ (next) => range = next as Range }
                                                latinNums
                                                class="ms-auto"
                                            />
                                        </div>
                                        <div class="h-44">
                                            <Show when={ !series.loading() } fallback={ <Skeleton class="h-full rounded-control" /> }>
                                                <Chart points={ series.data()?.points ?? [] } class="h-full" />
                                            </Show>
                                        </div>
                                    </Card>

                                    <Card padding="none" animate="rise" class="mb-5">
                                        <button
                                            class="flex h-12 w-full cursor-pointer items-center gap-2 px-4 text-[14px] font-bold"
                                            type="button"
                                            aria-expanded={ rulesOpen ? 'true' : 'false' }
                                            onClick={ () => rulesOpen = !rulesOpen }
                                        >
                                            <Icon name="rules" size={ 16 } class="text-muted" />
                                            <span>{ t('market.rules') }</span>
                                            <Icon name={ rulesOpen ? 'chevron-up' : 'chevron-down' } size={ 16 } class="ms-auto text-faint" />
                                        </button>
                                        <Show when={ rulesOpen }>
                                            <p class="border-t border-line px-4 py-3 text-[14px] leading-relaxed text-muted motion-safe:animate-fade">{ text(data().rules) }</p>
                                        </Show>
                                    </Card>

                                    <div class="mb-6 motion-safe:animate-rise">
                                        <Tabs
                                            tabs={ [
                                                { id: 'activity', label: t('market.activity') },
                                                { id: 'comments', label: t('market.comments') },
                                                { id: 'holders', label: t('market.holders') }
                                            ] }
                                            active={ tab }
                                            onChange={ (next) => tab = next }
                                        />
                                        <div class="pt-3">
                                            <Show when={ tab === 'activity' && activity.loading() }>
                                                <SkeletonList count={ 3 } height="h-9" class="pt-1" />
                                            </Show>
                                            <Show when={ tab === 'activity' && !activity.loading() }>
                                                <ul class="flex flex-col">
                                                    <For each={ activityView.rows } key={ (entry) => entry.id }>
                                                        { (entry) =>
                                                            <li class="flex items-center gap-3 border-b border-line py-2.5 text-[13px] last:border-b-0">
                                                                <span class={ entry.side === 'yes' ? 'h-2 w-2 shrink-0 rounded-full bg-yes' : 'h-2 w-2 shrink-0 rounded-full bg-no' } aria-hidden="true"></span>
                                                                <span class="min-w-0 flex-1 truncate">
                                                                    <span class="font-semibold">{ entry.user }</span>
                                                                    <span class="text-muted"> { entry.action === 'buy' ? t('market.bought') : t('market.sold') } </span>
                                                                    <span class="nums font-semibold">{ entry.shares }</span>
                                                                    <span class={ entry.side === 'yes' ? 'font-semibold text-yes' : 'font-semibold text-no' }> { entry.side === 'yes' ? t('market.yes') : t('market.no') } </span>
                                                                    <span class="nums text-muted">@ { formatPrice(entry.price, lang()) }</span>
                                                                </span>
                                                                <span class="shrink-0 text-faint">{ formatTimeAgo(entry.at, lang()) }</span>
                                                            </li>
                                                        }
                                                    </For>
                                                </ul>
                                                <div class="mt-4">
                                                    <Pagination page={ activityView.current } pages={ activityView.pages } onChange={ (next) => activityPage = next } />
                                                </div>
                                            </Show>
                                            <Show when={ tab === 'comments' && comments.loading() }>
                                                <SkeletonList count={ 2 } height="h-20" radius="card" gap="md" class="pt-1" />
                                            </Show>
                                            <Show when={ tab === 'comments' && !comments.loading() }>
                                                <ul class="flex flex-col gap-3">
                                                    <For each={ commentsView.rows } key={ (entry) => entry.id }>
                                                        { (entry) =>
                                                            <li class={ cardClass({ padding: 'snug' }) }>
                                                                <div class="mb-1.5 flex items-center gap-2 text-[13px]">
                                                                    <span class="flex h-7 w-7 items-center justify-center rounded-full bg-brand-soft text-[11px] font-bold text-brand" aria-hidden="true">{ entry.user.slice(0, 1).toUpperCase() }</span>
                                                                    <span class="font-semibold">{ entry.user }</span>
                                                                    <span class="text-faint">{ formatTimeAgo(entry.at, lang()) }</span>
                                                                    <span class="nums ms-auto flex items-center gap-1 text-faint"><Icon name="trending-up" size={ 13 } />{ entry.likes }</span>
                                                                </div>
                                                                <p class="text-[14px] leading-relaxed text-muted">{ text(entry.text) }</p>
                                                            </li>
                                                        }
                                                    </For>
                                                </ul>
                                                <div class="mt-4">
                                                    <Pagination page={ commentsView.current } pages={ commentsView.pages } onChange={ (next) => commentsPage = next } />
                                                </div>
                                            </Show>
                                            <Show when={ tab === 'holders' && holders.loading() }>
                                                <SkeletonList count={ 3 } height="h-9" class="pt-1" />
                                            </Show>
                                            <Show when={ tab === 'holders' && !holders.loading() }>
                                                <ul class="flex flex-col">
                                                    <For each={ holdersView.rows } key={ (entry) => entry.user + entry.outcomeId }>
                                                        { (entry) =>
                                                            <li class="flex items-center gap-3 border-b border-line py-2.5 text-[13px] last:border-b-0">
                                                                <span class="flex h-7 w-7 items-center justify-center rounded-full bg-gold-soft text-[11px] font-bold text-gold" aria-hidden="true">{ entry.user.slice(0, 1).toUpperCase() }</span>
                                                                <span class="min-w-0 flex-1 truncate font-semibold">{ entry.user }</span>
                                                                <Badge tone={ entry.side === 'yes' ? 'yes' : 'no' }>{ entry.side === 'yes' ? t('market.yes') : t('market.no') }</Badge>
                                                                <span class="nums w-20 text-end font-semibold">{ entry.shares.toLocaleString('en-US') }</span>
                                                            </li>
                                                        }
                                                    </For>
                                                </ul>
                                                <div class="mt-4">
                                                    <Pagination page={ holdersView.current } pages={ holdersView.pages } onChange={ (next) => holdersPage = next } />
                                                </div>
                                            </Show>
                                        </div>
                                    </div>

                                    <Show when={ related.length > 0 }>
                                        <h2 class="mb-3 text-lg font-bold tracking-tight">{ t('market.related') }</h2>
                                        <div class="rail rail-bleed rail-fade gap-4 pb-1">
                                            <For each={ related } key={ (entry) => entry.id }>
                                                { (entry) => <div class="w-[19rem] shrink-0"><MarketCard market={ entry } /></div> }
                                            </For>
                                        </div>
                                    </Show>
                                </div>

                                <aside class={ `${ cardClass({}) } sticky top-20 hidden lg:block` }>
                                    <TradeTicket market={ data() } outcome={ lead() } side={ side } onSideChange={ (next) => side = next } onConnect={ () => requestConnect() } />
                                </aside>
                            </div>

                            <div class="fixed inset-x-0 bottom-[calc(var(--tabbar-h)+env(safe-area-inset-bottom))] z-30 border-t border-line bg-chrome px-4 py-2.5 backdrop-blur-md lg:hidden">
                                <OutcomePair yesPrice={ lead().price } size="lg" buyLabel onPick={ (picked) => { side = picked; tradeOpen = true; } } />
                            </div>

                            <Sheet open={ tradeOpen } title={ text(data().title) } onClose={ () => tradeOpen = false }>
                                <TradeTicket market={ data() } outcome={ lead() } side={ side } onSideChange={ (next) => side = next } onConnect={ () => requestConnect() } />
                            </Sheet>
                        </div>
                    }
                </Show>
            }
        </Show>
    </section>
}
