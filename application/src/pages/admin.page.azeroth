import type { IconName } from '../icons/registry.ts';

import { useLocale } from '../stores/locale.store.ts';
import { useChrome } from '../stores/chrome.store.ts';
import { useSession } from '../stores/session.store.ts';
import { useAdmin } from '../stores/admin.store.ts';
import { useConfig } from '../stores/config.store.ts';

import Icon from '../icons/icon.component.azeroth';

import Button from '../components/ui/button.component.azeroth';
import EmptyState from '../components/ui/empty-state.component.azeroth';
import Skeleton from '../components/ui/skeleton.component.azeroth';

import AdminStats from '../components/admin/admin-stats.component.azeroth';
import MarketTable from '../components/admin/market-table.component.azeroth';
import CategoryTable from '../components/admin/category-table.component.azeroth';
import CreateMarketForm from '../components/admin/create-market-form.component.azeroth';
import TreasuryCard from '../components/admin/treasury-card.component.azeroth';
import ConfigCard from '../components/admin/config-card.component.azeroth';
import ActivityFeed from '../components/admin/activity-feed.component.azeroth';

// The operator console. Lists and stats come from the indexer (server-side search/filter/
// pagination - instant at a 100k-market registry); the role gate and every write go
// straight to the chain through the connected wallet. Gated on the factory's ADMIN_ROLE.
export default component Admin()
{
    const { t } = useLocale();
    const chrome = useChrome();
    const session = useSession();
    const admin = useAdmin();
    const config = useConfig();

    // The chain moves while this page is away; every visit re-pulls the read model.
    admin.refresh();

    state section = 'markets';

    derived sections = [
        { id: 'markets', label: t('admin.sectionMarkets'), icon: 'chart' as IconName },
        { id: 'categories', label: t('admin.sectionCategories'), icon: 'tag' as IconName },
        { id: 'create', label: t('admin.sectionCreate'), icon: 'plus' as IconName },
        { id: 'treasury', label: t('admin.sectionTreasury'), icon: 'wallet' as IconName },
        { id: 'factory', label: t('admin.sectionFactory'), icon: 'settings' as IconName },
        { id: 'activity', label: t('admin.sectionActivity'), icon: 'activity' as IconName }
    ];

    <section class="shell py-5">
        <Show
            when={ session.connected() }
            fallback={
                    <EmptyState icon="wallet" tone="brand" size="lg" heading title={ t('profile.connectTitle') } hint={ t('admin.deniedHint') }>
                        <Button onClick={ () => chrome.openAuth() }>{ t('auth.title') }</Button>
                    </EmptyState>
                }
        >
            <Show
                when={ config.error() === null }
                fallback={ <EmptyState icon="globe" size="lg" heading title={ t('admin.noDeployment') } hint={ t('admin.noDeploymentHint') } /> }
            >
                <Show when={ admin.checking() || (config.loading() && config.data() === undefined) }>
                    <Skeleton class="h-64 rounded-card" />
                </Show>
                <Show when={ !admin.checking() && config.data() !== undefined && !admin.isAdmin() }>
                    <EmptyState icon="alert" tone="danger" size="lg" heading title={ t('admin.denied') } hint={ t('admin.deniedHint') } />
                </Show>
                <Show when={ !admin.checking() && admin.isAdmin() }>
                    <header class="mb-5 flex flex-wrap items-center gap-3 motion-safe:animate-rise">
                        <div class="min-w-0 flex-1">
                            <h1 class="text-xl font-bold tracking-tight sm:text-2xl">{ t('admin.title') }</h1>
                            <p class="text-[13px] text-muted">{ t('admin.subtitle') }</p>
                        </div>
                        <Show when={ section !== 'create' }>
                            <Button variant="primary" size="sm" icon="plus" onClick={ () => section = 'create' }>{ t('admin.create') }</Button>
                        </Show>
                    </header>

                    <div class="mb-6">
                        <AdminStats />
                    </div>

                    <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-[13rem_minmax(0,1fr)]">
                        <nav class="rail rail-bleed rail-fade min-w-0 gap-2 lg:sticky lg:top-20 lg:flex-col lg:gap-1" aria-label={ t('admin.title') }>
                            <For each={ sections } key={ (entry) => entry.id }>
                            { (entry) =>
                                <button
                                    class={ section === entry.id
                                        ? 'flex h-11 shrink-0 cursor-pointer items-center gap-2.5 rounded-control bg-overlay px-3.5 text-[14px] font-bold text-text lg:w-full'
                                        : 'flex h-11 shrink-0 cursor-pointer items-center gap-2.5 rounded-control px-3.5 text-[14px] font-semibold text-muted transition-colors duration-200 hover:text-text lg:w-full' }
                                    type="button"
                                    onClick={ () => section = entry.id }
                                >
                                    <Icon name={ entry.icon } size={ 17 } />
                                    <span>{ entry.label }</span>
                                </button>
                            }
                            </For>
                        </nav>

                        <div class="min-w-0 motion-safe:animate-fade">
                            <Show when={ section === 'markets' }>
                                <MarketTable />
                            </Show>
                            <Show when={ section === 'categories' }>
                                <CategoryTable />
                            </Show>
                            <Show when={ section === 'create' }>
                                <CreateMarketForm />
                            </Show>
                            <Show when={ section === 'treasury' }>
                                <div class="mx-auto max-w-xl">
                                    <TreasuryCard />
                                </div>
                            </Show>
                            <Show when={ section === 'factory' }>
                                <div class="mx-auto max-w-xl">
                                    <ConfigCard />
                                </div>
                            </Show>
                            <Show when={ section === 'activity' }>
                                <ActivityFeed />
                            </Show>
                        </div>
                    </div>
                </Show>
            </Show>
        </Show>
    </section>
}
