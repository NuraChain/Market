import { client } from '../../api.ts';

import { useLocale } from '../../stores/locale.store.ts';
import { useSession } from '../../stores/session.store.ts';
import { useOnchain } from '../../stores/onchain.store.ts';

import { formatShares } from '../../i18n/format.ts';

import Icon from '../../icons/icon.component.azeroth';

import Button from '../ui/button.component.azeroth';
import Card from '../ui/card.component.azeroth';
import EmptyState from '../ui/empty-state.component.azeroth';
import SkeletonList from '../ui/skeleton-list.component.azeroth';

// Winnings the connected wallet can redeem: the indexer flags positions whose market
// resolved their way (or voided); Claim calls redeem() on the market itself.
export default component ClaimableList(props: { onClaimed?: () => void })
{
    const { t, lang, text } = useLocale();
    const session = useSession();
    const onchain = useOnchain();

    resource positions = (address: string) =>
        client.portfolio.positions({ query: { address } })
        with { source: session.connected() ? session.address() : false };

    derived claims = (positions.data() ?? []).filter((position) => position.claimable);

    const claim = async (address: string): Promise<void> =>
    {
        if (await onchain.claim(address as `0x${ string }`))
        {
            positions.refetch();
            props.onClaimed?.();
        }
    };

    <div class="flex flex-col gap-3">
        <div>
            <h2 class="text-lg font-bold tracking-tight">{ t('chain.claimTitle') }</h2>
            <p class="text-[13px] text-muted">{ t('chain.claimHint') }</p>
        </div>

        <Show when={ positions.loading() && positions.data() === undefined }>
            <SkeletonList count={ 2 } height="h-16" radius="card" gap="md" />
        </Show>

        <Show when={ positions.data() !== undefined && claims.length === 0 }>
            <EmptyState icon="wallet" title={ t('chain.noClaims') } hint={ t('chain.noClaimsHint') } />
        </Show>

        <Show when={ claims.length > 0 }>
            <ul class="grid grid-cols-1 gap-3">
                <For each={ claims } key={ (entry) => entry.id } let={ entry }>
                    <li>
                        <Card class="flex items-center gap-3">
                            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-control bg-yes-soft text-yes" aria-hidden="true">
                                <Icon name="trophy" size={ 18 } />
                            </span>
                            <span class="min-w-0 flex-1">
                                <span class="block truncate text-[14px] font-bold">{ text(entry.market.title) }</span>
                                <span class="nums block text-[12px] text-muted">
                                        { formatShares(entry.shares, lang()) }
                                </span>
                            </span>
                            <Button
                                variant="primary"
                                size="sm"
                                disabled={ onchain.pending() }
                                loading={ onchain.busy(`claim:${ entry.market.address }`) }
                                onClick={ () => void claim(entry.market.address) }
                            >
                                    { t('chain.claim') }
                            </Button>
                        </Card>
                    </li>
                </For>
            </ul>
        </Show>
    </div>
}
