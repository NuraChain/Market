import { Link } from 'azerothjs';
import { client, type Market } from '../../api.ts';

import { isBinary } from '../../lib/market.ts';

import { useLocale } from '../../stores/locale.store.ts';

import { formatPercent, formatVolume, formatDateTimeShort } from '../../i18n/format.ts';

import Icon from '../../icons/icon.component.azeroth';

import Chart from '../ui/chart.component.azeroth';
import Badge from '../ui/badge.component.azeroth';
import Skeleton from '../ui/skeleton.component.azeroth';
import { cardClass } from '../ui/variants.ts';
import FavoriteButton from './favorite-button.component.azeroth';
import OutcomePair from './outcome-pair.component.azeroth';

// The featured rail's wide card: headline chance, a live week chart, and the outcome
// buttons - the storefront window. Series load lazily per card, anchored to the shown
// price. The card is width-agnostic: the rail that mounts it owns the sizing.
export default component HeroCard(props: { market: Market })
{
    const { t, lang, text } = useLocale();

    derived lead = props.market.outcomes.reduce((best, candidate) => (candidate.price > best.price ? candidate : best), props.market.outcomes[0]!);
    derived detailPath = `/market/${ props.market.id }`;

    resource series = () => client.markets.series({
        params: { id: props.market.id },
        query: { outcome: lead.id, range: '1w' }
    });

    <article class={ `${ cardClass({ interactive: true }) } flex h-full flex-col` }>
        <div class="mb-2 flex items-start gap-3">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-control bg-overlay text-xl" aria-hidden="true">{ props.market.emoji }</span>
            <Link to={ detailPath } class="min-h-[2.75em] min-w-0 flex-1 text-[15px] font-bold leading-snug text-text no-underline line-clamp-2 hover:text-brand">
                { text(props.market.title) }
            </Link>
            <FavoriteButton marketId={ props.market.id } />
        </div>

        <div class="mb-1 flex items-end justify-between">
            <div>
                <p class="nums text-2xl font-bold text-brand">{ formatPercent(lead.price, lang()) }</p>
                <p class="text-[12px] text-muted">
                    { isBinary(props.market) ? t('market.chance') : text(lead.label) }
                </p>
            </div>
            <Badge tone="gold" icon="sparkles">{ t('home.featured') }</Badge>
        </div>

        <div class="mb-3 h-14">
            <Show when={ !series.loading() } fallback={ <Skeleton class="h-full rounded-control" /> }>
                <Chart points={ series.data()?.points ?? [] } class="h-full" />
            </Show>
        </div>

        <OutcomePair yesPrice={ lead.price } to={ detailPath } class="mb-3" />

        <div class="mt-auto flex items-center justify-between gap-3 text-[12px] text-faint">
            <span class="nums flex items-center gap-1"><Icon name="volume" size={ 13 } />{ formatVolume(props.market.volume, lang()) }</span>
            <span class="nums flex shrink-0 items-center gap-1 whitespace-nowrap rounded-full border border-line px-2 py-0.5">
                <Icon name="clock" size={ 12 } />
                { formatDateTimeShort(props.market.endsAt, lang()) }
            </span>
        </div>
    </article>
}
