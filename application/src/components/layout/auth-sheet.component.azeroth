import { useLocale } from '../../stores/locale.store.ts';
import { useChrome } from '../../stores/chrome.store.ts';
import { useSession, WalletUnavailableError } from '../../stores/session.store.ts';
import { useToasts } from '../../stores/toasts.store.ts';

import { WALLET_LABEL, type WalletBrand } from '../../icons/brands.ts';
import BrandIcon from '../../icons/brand-icon.component.azeroth';
import Icon from '../../icons/icon.component.azeroth';

import Sheet from '../ui/sheet.component.azeroth';

// Wallet-ONLY auth: the wallet IS the account system on a web3 market. Still ONE surface,
// ever - the anti-pattern this replaces is a QR overlay stacked on a dialog stacked on a
// modal. Picking a wallet asks its REAL injected provider for accounts; a missing
// extension and a declined request each answer with an honest toast.
export default component AuthSheet()
{
    const { t } = useLocale();
    const chrome = useChrome();
    const session = useSession();
    const toasts = useToasts();

    derived wallets = Object.keys(WALLET_LABEL) as WalletBrand[];

    const pick = async (brand: WalletBrand): Promise<void> =>
    {
        if (session.connecting() !== null)
        {
            return;
        }
        try
        {
            await session.connect(brand);
            chrome.close();
            toasts.push('success', t('toast.connected'), 'wallet');
        }
        catch (error)
        {
            if (error instanceof WalletUnavailableError)
            {
                toasts.push('error', `${ WALLET_LABEL[brand] } ${ t('auth.notDetected') }`, 'alert');
            }
            else
            {
                toasts.push('info', t('auth.rejected'), 'info');
            }
        }
    };

    <Sheet open={ chrome.authOpen() } title={ t('auth.title') } onClose={ () => chrome.close() }>
        <div class="flex flex-col gap-4">
            <p class="text-[14px] text-muted">{ t('auth.subtitle') }</p>

            <div class="grid grid-cols-2 gap-2">
                <For each={ wallets } key={ (brand) => brand }>
                    { (brand) =>
                        <button
                            class={ session.connecting() !== null && session.connecting() !== brand
                                ? 'flex h-14 cursor-pointer items-center gap-3 rounded-control border border-line bg-raised px-3 opacity-40 transition duration-200'
                                : 'flex h-14 cursor-pointer items-center gap-3 rounded-control border border-line bg-raised px-3 transition duration-200 hover:border-line-strong hover:bg-overlay active:scale-[0.98]' }
                            type="button"
                            disabled={ session.connecting() !== null }
                            onClick={ () => void pick(brand) }
                        >
                            <BrandIcon brand={ brand } size={ 26 } />
                            <span class="min-w-0 flex-1 truncate text-start text-[13px] font-semibold">
                                <Show when={ session.connecting() === brand }>
                                    <span class="text-muted">{ t('auth.connecting') }...</span>
                                </Show>
                                <Show when={ session.connecting() !== brand }>
                                    { WALLET_LABEL[brand] }
                                </Show>
                            </span>
                            <Show when={ session.connecting() === brand }>
                                <span class="h-4 w-4 shrink-0 animate-spin rounded-full border-2 border-line border-t-brand" aria-hidden="true"></span>
                            </Show>
                        </button>
                    }
                </For>
            </div>

            <p class="flex items-start gap-2 text-[12px] leading-relaxed text-faint">
                <Icon name="info" size={ 14 } class="mt-0.5 shrink-0" />
                <span>{ t('auth.terms') }</span>
            </p>
        </div>
    </Sheet>
}
