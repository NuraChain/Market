                        <span class="text-[17px] font-bold tracking-tight">{ t('app.name') }</span>
                    </div>
                    <p class="mb-4 text-[14px] text-muted">{ t('app.tagline') }</p>
                    <div class="flex gap-1">
                        <Tooltip label={ t('footer.contact') }>
                            <a class="flex h-10 w-10 items-center justify-center rounded-control text-muted transition-colors duration-200 hover:bg-overlay hover:text-text" href="mailto:intelligentquantum@example.org" aria-label={ t('footer.contact') }><Icon name="mail" size={ 18 } /></a>
                        </Tooltip>
                        <Tooltip label={ t('footer.community') }>
                            <a class="flex h-10 w-10 items-center justify-center rounded-control text-muted transition-colors duration-200 hover:bg-overlay hover:text-text" href="mailto:intelligentquantum@example.org" aria-label={ t('footer.community') }><Icon name="send" size={ 18 } /></a>
                        </Tooltip>
                        <Tooltip label={ t('footer.community') }>
                            <a class="flex h-10 w-10 items-center justify-center rounded-control text-muted transition-colors duration-200 hover:bg-overlay hover:text-text" href="mailto:intelligentquantum@example.org" aria-label={ t('footer.community') }><Icon name="messages" size={ 18 } /></a>
                        </Tooltip>
                    </div>
                </div>

                <nav aria-label={ t('footer.markets') }>
                    <h2 class="mb-3 text-[13px] font-bold uppercase tracking-wide text-faint">{ t('footer.markets') }</h2>
                    <ul class="grid grid-cols-1 gap-2 text-[14px]">
                        <li><Link class="text-muted no-underline transition-colors duration-200 hover:text-text" to="/browse">{ t('categories.politics') }</Link></li>
                        <li><Link class="text-muted no-underline transition-colors duration-200 hover:text-text" to="/browse">{ t('categories.crypto') }</Link></li>
                        <li><Link class="text-muted no-underline transition-colors duration-200 hover:text-text" to="/browse">{ t('categories.sports') }</Link></li>
                        <li><Link class="text-muted no-underline transition-colors duration-200 hover:text-text" to="/browse">{ t('categories.economy') }</Link></li>
                        <li><Link class="text-muted no-underline transition-colors duration-200 hover:text-text" to="/browse">{ t('categories.tech') }</Link></li>
                    </ul>
                </nav>

                <nav aria-label={ t('footer.product') }>
                    <h2 class="mb-3 text-[13px] font-bold uppercase tracking-wide text-faint">{ t('footer.product') }</h2>
                    <ul class="grid grid-cols-1 gap-2 text-[14px]">
                        <li><Link class="text-muted no-underline transition-colors duration-200 hover:text-text" to="/browse">{ t('nav.browse') }</Link></li>
                        <li><Link class="text-muted no-underline transition-colors duration-200 hover:text-text" to="/portfolio">{ t('nav.portfolio') }</Link></li>
                        <li><Link class="text-muted no-underline transition-colors duration-200 hover:text-text" to="/leaderboard">{ t('nav.leaderboard') }</Link></li>
                        <li><Link class="text-muted no-underline transition-colors duration-200 hover:text-text" to="/settings">{ t('nav.settings') }</Link></li>
                    </ul>
                </nav>

                <nav aria-label={ t('footer.community') }>
                    <h2 class="mb-3 text-[13px] font-bold uppercase tracking-wide text-faint">{ t('footer.community') }</h2>
                    <ul class="grid grid-cols-1 gap-2 text-[14px]">
                        <li><a class="text-muted no-underline transition-colors duration-200 hover:text-text" href="https://github.com" target="_blank" rel="noreferrer">GitHub</a></li>
                        <li><a class="text-muted no-underline transition-colors duration-200 hover:text-text" href="mailto:intelligentquantum@example.org">{ t('footer.contact') }</a></li>
