import type { Child } from 'azerothjs';
import Icon from '../../icons/icon.component.azeroth';
import type { IconName } from '../../icons/registry.ts';

import { buttonClass, type ButtonVariant, type ButtonSize } from './variants.ts';

export default component Button(props: {
    variant?: ButtonVariant;
    size?: ButtonSize;
    block?: boolean;
    disabled?: boolean;
    submit?: boolean;
    icon?: IconName;

    /** Required when the button renders no visible text (icon-only). */
    label?: string;

    onClick?: () => void;
    children?: Child;
})
{
    <button
        class={ buttonClass(props.variant ?? 'primary', props.size ?? 'md', props.block ?? false) }
        type={ props.submit === true ? 'submit' : 'button' }
        disabled={ props.disabled ?? false }
        aria-label={ props.label }
        onClick={ () => props.onClick?.() }
    >
        <Show when={ props.icon !== undefined }>
            <Icon name={ props.icon ?? 'circle-help' } size={ 18 } />
        </Show>
        { props.children }
    </button>
}
