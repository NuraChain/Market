import type { Child } from 'azerothjs';
import Icon from '../../icons/icon.component.azeroth';
import type { IconName } from '../../icons/registry.ts';

import { chipClass } from './variants.ts';

export default component Chip(props: {
    selected?: boolean;
    icon?: IconName;

    /** Rail-density chips: shorter on mobile, icon appears from sm up only. */
    compact?: boolean;

    onSelect?: () => void;
    children?: Child;
})
{
    <button
        class={ chipClass(props.selected ?? false, props.compact ?? false) }
        type="button"
        aria-pressed={ props.selected === true ? 'true' : 'false' }
        onClick={ () => props.onSelect?.() }
    >
        <Show when={ props.icon !== undefined }>
            <span class={ props.compact === true ? 'hidden sm:inline-flex' : 'inline-flex' }>
                <Icon name={ props.icon ?? 'circle-help' } size={ 15 } />
            </span>
        </Show>
        { props.children }
    </button>
}
