import type { Child } from 'azerothjs';

import type { IconName } from '../../icons/registry.ts';
import Icon from '../../icons/icon.component.azeroth';

// The centered empty/error state: icon circle, title, hint, one action. `heading` renders
// the title as the page's h1 for full-page gates (the signed-out portfolio).
export default component EmptyState(props: {
    icon: IconName;
    tone?: 'muted' | 'brand' | 'danger';
    size?: 'md' | 'lg';
    title?: string;
    hint?: string;
    heading?: boolean;
    children?: Child;
})
{
    derived circle = ((): string =>
    {
        const tone = props.tone === 'brand'
            ? 'bg-brand-soft text-brand'
            : props.tone === 'danger' ? 'bg-no-soft text-no' : 'bg-overlay text-muted';
        const size = props.size === 'lg' ? 'h-14 w-14' : 'h-12 w-12';
        return `mx-auto mb-4 flex ${ size } items-center justify-center rounded-sheet ${ tone }`;
    })();

    <div class={ props.size === 'lg' ? 'mx-auto max-w-sm py-20 text-center motion-safe:animate-rise' : 'mx-auto max-w-sm py-14 text-center motion-safe:animate-rise' }>
        <span class={ circle }><Icon name={ props.icon } size={ props.size === 'lg' ? 26 : 22 } /></span>
        <Show when={ props.title !== undefined }>
            <Show
                when={ props.heading === true }
                fallback={ <p class="mb-1 font-bold">{ props.title }</p> }
            >
                <h1 class="mb-1 text-xl font-bold tracking-tight">{ props.title }</h1>
            </Show>
        </Show>
        <Show when={ props.hint !== undefined }>
            <p class="mb-5 text-[14px] text-muted">{ props.hint }</p>
        </Show>
        { props.children }
    </div>
}
