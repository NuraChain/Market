import { createEffect, type Child } from 'azerothjs';

import { useLocale } from '../../stores/locale.store.ts';

import Icon from '../../icons/icon.component.azeroth';

import Tooltip from './tooltip.component.azeroth';

// THE horizontal rail. Mobile/tablet: a swipe rail bleeding to the screen edge with the next
// item peeking. Desktop: a contained, page-wise slider - arrows beside the heading, optional
// dot indicators. The scroll math is direction-aware (RTL scrollLeft runs negative) and honors
// prefers-reduced-motion.
//
// One owner on purpose: the dot mapping, the RTL sign, and the rounding slop below are each a
// bug that was found and fixed once. A second rail that restated them would be a second place
// for them to be wrong, and the two would drift silently because they look identical.
//
// An EMPTY rail renders nothing at all - heading included. A section title with arrows over
// no content reads as a loading failure, and the caller should not have to guard every use.
//
// Two arrow placements, because a rail with a section heading and a bare chip strip want
// different things: 'heading' (default) puts them in the heading row beside `heading`/
// `trailing`; 'edge' floats them over the rail's own left/right edges, for a rail that has no
// heading to hang them from. Both appear only from lg - below that the rail bleeds to the
// screen edge and is swipe-only, which is the design law FeaturedRail established.
export default component Rail<T>(props: {
    items: T[];
    key: (item: T) => string | number;
    children: (item: T) => Child;
    label: string;
    slotClass: string;
    dots?: boolean;
    arrows?: 'heading' | 'edge';
    heading?: Child;
    trailing?: Child;
    railClass?: string;
})
{
    const { t, dir } = useLocale();

    state page = 0;
    state pages = 1;
    state atStart = true;
    state atEnd = true;

    let rail: HTMLElement | null = null;

    const measure = (): void =>
    {
        if (rail === null)
        {
            return;
        }
        const width = rail.clientWidth;
        const total = rail.scrollWidth;
        const position = Math.abs(rail.scrollLeft);
        pages = width > 0 ? Math.max(1, Math.ceil((total - 4) / width)) : 1;
        // The active dot maps scroll PROGRESS onto the dot range - never `position / width`:
        // the last page is usually a fraction of a viewport (5 cards, 4 per view leaves 0.27),
        // and viewport rounding pins the first dot active forever on wide screens.
        const maxScroll = Math.max(1, total - width);
        page = pages > 1 ? Math.min(pages - 1, Math.round((position / maxScroll) * (pages - 1))) : 0;
        atStart = position <= 1;
        atEnd = position >= total - width - 1;
    };

    const behavior = (): ScrollBehavior =>
        (typeof matchMedia !== 'undefined' && matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth');

    /** +1 pages toward the reading end; RTL scroll offsets run negative. */
    const forward = (): number => (dir() === 'rtl' ? -1 : 1);

    const go = (delta: number): void =>
    {
        rail?.scrollBy({ left: forward() * delta * rail.clientWidth, behavior: behavior() });
    };

    const jump = (target: number): void =>
    {
        if (rail === null)
        {
            return;
        }
        // The inverse of measure()'s mapping, so landing on dot N always measures back to N.
        const maxScroll = Math.max(0, rail.scrollWidth - rail.clientWidth);
        rail.scrollTo({ left: forward() * (pages > 1 ? (target * maxScroll) / (pages - 1) : 0), behavior: behavior() });
    };

    createEffect(() =>
    {
        void props.items;
        if (typeof window === 'undefined')
        {
            return;
        }
        requestAnimationFrame(measure);
        window.addEventListener('resize', measure);
        return () => window.removeEventListener('resize', measure);
    });

    const arrowClass = 'flex h-8 w-8 cursor-pointer items-center justify-center rounded-control border border-line text-muted transition-colors duration-200 hover:bg-overlay hover:text-text disabled:pointer-events-none disabled:opacity-40';

    <Show when={ props.items.length > 0 }>
        <div class={ props.arrows === 'edge' ? 'relative' : '' }>
            <Show when={ props.arrows !== 'edge' }>
                <div class="mb-3 flex items-center justify-between gap-2">
                { props.heading }
                    <div class="flex items-center gap-2">
                    { props.trailing }
                        <div class="hidden items-center gap-1 lg:flex">
                            <Tooltip label={ t('common.previous') }>
                                <button
                                    class={ arrowClass }
                                    type="button"
                                    aria-label={ `${ props.label }: ${ t('common.previous') }` }
                                    disabled={ atStart }
                                    onClick={ () => go(-1) }
                                >
                                    <Icon name="chevron-left" size={ 16 } />
                                </button>
                            </Tooltip>
                            <Tooltip label={ t('common.next') }>
                                <button
                                    class={ arrowClass }
                                    type="button"
                                    aria-label={ `${ props.label }: ${ t('common.next') }` }
                                    disabled={ atEnd }
                                    onClick={ () => go(1) }
                                >
                                    <Icon name="chevron-right" size={ 16 } />
                                </button>
                            </Tooltip>
                        </div>
                    </div>
                </div>
            </Show>

            <div
                class={ `rail rail-bleed rail-fade gap-4 pb-1 lg:[scroll-snap-type:x_mandatory] ${ props.railClass ?? '' }` }
                ref={ (element) => { rail = element; } }
                onScroll={ () => measure() }
            >
                <For each={ props.items } key={ props.key }>
                { (item) => <div class={ props.slotClass }>{ props.children(item) }</div> }
                </For>
            </div>

            <Show when={ props.arrows === 'edge' }>
                <div>
                    <div class={ atStart ? 'hidden' : 'absolute inset-y-0 start-0 hidden items-center lg:flex' }>
                        <button
                            class={ `${ arrowClass } bg-surface shadow-md` }
                            type="button"
                            aria-label={ `${ props.label }: ${ t('common.previous') }` }
                            onClick={ () => go(-1) }
                        >
                            <Icon name="chevron-left" size={ 16 } />
                        </button>
                    </div>
                    <div class={ atEnd ? 'hidden' : 'absolute inset-y-0 end-0 hidden items-center lg:flex' }>
                        <button
                            class={ `${ arrowClass } bg-surface shadow-md` }
                            type="button"
                            aria-label={ `${ props.label }: ${ t('common.next') }` }
                            onClick={ () => go(1) }
                        >
                            <Icon name="chevron-right" size={ 16 } />
                        </button>
                    </div>
                </div>
            </Show>

            <Show when={ props.dots !== false && pages > 1 }>
                <div class="mt-3 hidden justify-center gap-1.5 lg:flex">
                    <For each={ Array.from({ length: pages }, (_item, position) => position) } key={ (position) => position }>
                    { (position) =>
                        <button
                            class={ page === position
                                ? 'h-1.5 w-5 rounded-full bg-brand transition-all duration-200'
                                : 'h-1.5 w-1.5 cursor-pointer rounded-full bg-text/25 transition-all duration-200 hover:bg-text/45' }
                            type="button"
                            aria-label={ `${ props.label } ${ position + 1 }` }
                            aria-current={ page === position ? 'true' : 'false' }
                            onClick={ () => jump(position) }
                        ></button>
                    }
                    </For>
                </div>
            </Show>
        </div>
    </Show>
}
