import type { Child } from 'azerothjs';
import Icon from '../../icons/icon.component.azeroth';
import type { IconName } from '../../icons/registry.ts';

import { badgeClass, type BadgeTone } from './variants.ts';

export default component Badge(props: {
    tone?: BadgeTone;
    icon?: IconName;
    children?: Child;
})
{
    <span class={ badgeClass(props.tone ?? 'muted') }>
        <Show when={ props.icon !== undefined }>
            <Icon name={ props.icon ?? 'circle-help' } size={ 12 } />
        </Show>
        { props.children }
    </span>
}
