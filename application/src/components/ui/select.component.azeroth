import { dismissOn } from '../../composables/dismiss.composable.ts';

import type { IconName } from '../../icons/registry.ts';
import Icon from '../../icons/icon.component.azeroth';

import { MENU_PANEL } from './variants.ts';

// The dropdown from the filter-row reference: a chip trigger, an overlay menu with icon
// options and a selected check. Any press outside, Escape, and selection all close it;
// arrows + Enter drive it from the keyboard, and the panel flips to the edge that keeps
// it on screen.
export default component Select(props: {
    options: Array<{ id: string; label: string; icon?: IconName }>;
    value: string;
    onChange: (id: string) => void;
    label: string;
})
{
    state open = false;
    state active = 0;
    state alignEnd = false;

    let root: HTMLElement | null = null;
    let trigger: HTMLElement | null = null;

    derived selected = props.options.find((option) => option.id === props.value);

    dismissOn({
        open: () => open,
        close: () => open = false,
        root: () => root,
        trigger: () => trigger
    });

    // min-w-44 on the panel; the flip check uses the same number.
    const PANEL_MIN = 176;

    const openMenu = (): void =>
    {
        active = Math.max(0, props.options.findIndex((option) => option.id === props.value));
        if (trigger !== null)
        {
            const rect = trigger.getBoundingClientRect();
            const rtl = document.documentElement.dir === 'rtl';
            alignEnd = rtl ? rect.right - PANEL_MIN < 8 : rect.left + PANEL_MIN > window.innerWidth - 8;
        }
        open = true;
    };

    const choose = (id: string): void =>
    {
        props.onChange(id);
        open = false;
        trigger?.focus();
    };

    const onKeys = (event: KeyboardEvent): void =>
    {
        if (!open)
        {
            return;
        }
        if (event.key === 'ArrowDown')
        {
            event.preventDefault();
            active = Math.min(props.options.length - 1, active + 1);
        }
        else if (event.key === 'ArrowUp')
        {
            event.preventDefault();
            active = Math.max(0, active - 1);
        }
        else if (event.key === 'Enter')
        {
            event.preventDefault();
            const option = props.options[active];
            if (option !== undefined)
            {
                choose(option.id);
            }
        }
    };

    <div class="relative inline-flex" ref={ (element: HTMLElement) => { root = element; } } onKeydown={ (event) => onKeys(event as KeyboardEvent) }>
        <button
            class="flex h-9 cursor-pointer items-center gap-1.5 rounded-control border border-line bg-raised px-3 text-[13px] font-semibold text-text transition-colors duration-200 hover:border-line-strong"
            type="button"
            aria-haspopup="listbox"
            aria-expanded={ open ? 'true' : 'false' }
            aria-label={ props.label }
            ref={ (element: HTMLElement) => { trigger = element; } }
            onClick={ () => { if (open) { open = false; } else { openMenu(); } } }
        >
            <Show when={ selected !== undefined && selected.icon !== undefined }>
                <Icon name={ selected?.icon ?? 'sort' } size={ 15 } class="text-muted" />
            </Show>
            { selected?.label ?? props.label }
            <Icon name="chevron-down" size={ 15 } class="text-faint" />
        </button>

        <Show when={ open }>
            <ul
                class={ `absolute ${ alignEnd ? 'end-0' : 'start-0' } top-10 min-w-44 p-1 ${ MENU_PANEL }` }
                role="listbox"
                aria-label={ props.label }
            >
                <For each={ props.options } key={ (option) => option.id }>
                    { (option, index) =>
                        <li role="option" aria-selected={ props.value === option.id ? 'true' : 'false' }>
                            <button
                                class={ index === active
                                    ? 'flex h-10 w-full cursor-pointer items-center gap-2.5 rounded-control bg-raised px-3 text-[13.5px] font-semibold text-text'
                                    : 'flex h-10 w-full cursor-pointer items-center gap-2.5 rounded-control px-3 text-[13.5px] font-semibold text-muted transition-colors duration-200 hover:bg-raised hover:text-text' }
                                type="button"
                                onClick={ () => choose(option.id) }
                                onMouseenter={ () => active = index }
                            >
                                <Show when={ option.icon !== undefined }>
                                    <Icon name={ option.icon ?? 'sort' } size={ 15 } class="text-muted" />
                                </Show>
                                <span class="min-w-0 flex-1 truncate text-start">{ option.label }</span>
                                <Show when={ props.value === option.id }>
                                    <Icon name="check" size={ 15 } class="text-brand" />
                                </Show>
                            </button>
                        </li>
                    }
                </For>
            </ul>
        </Show>
    </div>
}
