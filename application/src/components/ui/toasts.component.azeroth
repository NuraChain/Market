import { useToasts } from '../../stores/toasts.store.ts';

import ToastItem from './toast-item.component.azeroth';

// The toast host: bottom-centered, riding above the tab bar via the shared --tabbar-h.
// pointer-events pass through the empty stack; each toast re-enables its own.
export default component Toasts()
{
    const toasts = useToasts();

    <div
        class="pointer-events-none fixed inset-x-0 bottom-[calc(var(--tabbar-h)+env(safe-area-inset-bottom)+0.75rem)] z-[60] flex flex-col items-center gap-2 px-4 lg:bottom-6"
        aria-live="polite"
    >
        <For each={ toasts.items() } key={ (toast) => toast.id }>
            { (toast) => <ToastItem toast={ toast } onDismiss={ () => toasts.dismiss(toast.id) } /> }
        </For>
    </div>
}
