import Skeleton from './skeleton.component.azeroth';

// A stack of placeholder rows - the loading shape of every list. `height` is a complete
// Tailwind height utility spelled at the call site so the scanner sees it.
export default component SkeletonList(props: {
    count: number;
    height: string;
    radius?: 'control' | 'card';
    gap?: 'sm' | 'md';
    class?: string;
})
{
    derived slots = Array.from({ length: props.count }, (_slot, index) => index);
    derived item = `${ props.height } ${ props.radius === 'card' ? 'rounded-card' : 'rounded-control' }`;

    <div class={ `${ props.gap === 'md' ? 'flex flex-col gap-3' : 'flex flex-col gap-2' }${ props.class !== undefined ? ` ${ props.class }` : '' }` }>
        <For each={ slots } key={ (slot) => slot }>
            { () => <Skeleton class={ item } /> }
        </For>
    </div>
}
