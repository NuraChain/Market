import { parseEther } from 'viem';

import { encodeTitleMeta, encodeTextMeta } from '../../api.ts';

import { categoryIcon } from '../../lib/market.ts';
import { chain, explorerTxUrl } from '../../lib/chain.ts';

import { useLocale } from '../../stores/locale.store.ts';
import { useAdmin } from '../../stores/admin.store.ts';
import { useOnchain } from '../../stores/onchain.store.ts';
import { useCreateDraft } from '../../stores/create-draft.store.ts';
import { useCategories } from '../../stores/categories.store.ts';

import Icon from '../../icons/icon.component.azeroth';

import ImageField from './image-field.component.azeroth';

import Tooltip from '../ui/tooltip.component.azeroth';
import Card from '../ui/card.component.azeroth';
import Button from '../ui/button.component.azeroth';
import Chip from '../ui/chip.component.azeroth';
import Input from '../ui/input.component.azeroth';

const EMOJI = ['🔥', '₿', '⚽', '🏆', '🗳️', '🎬', '🚀', '📈', '📉', '🌍', '🧪', '💻', '🎮', '🏛️', '⚖️', '🎯'];
type Step = 'question' | 'outcomes' | 'timing' | 'review';
const STEPS: Step[] = ['question', 'outcomes', 'timing', 'review'];
const FEE_MAX = 1000;
const SHARE_MAX = 10_000;

// The create surface, as its own admin section rather than a 416px sheet. Bilingual
// title/description and the emoji ride the on-chain metadata envelope; the category is FREE
// TEXT over the registered ones - typing a new name mints it. Every field lives in the draft
// store so leaving the section and coming back does not lose a half-written market.
export default component CreateMarketForm()
{
    const { t } = useLocale();
    const admin = useAdmin();
    const onchain = useOnchain();
    const draft = useCreateDraft();
    const categories = useCategories();

    state step: Step = 'question';
    state created: { hash: string; marketId: number | null; address: string | null } | null = null;
    state visited: Step[] = [];

    derived suggestions = categories.active()
        .filter((entry) => draft.category().trim() === '' || entry.id.includes(draft.category().trim().toLowerCase()))
        .slice(0, 10);

    derived matched = (categories.list.data() ?? []).some((entry) => entry.id === draft.category().trim().toLowerCase());

    // A row with a Persian label and no English one used to be dropped in silence, so a
    // 3-outcome market deployed with 2. Every started row must carry an English name.
    derived started = draft.outcomes().filter((outcome) => outcome.en.trim() !== '' || outcome.fa.trim() !== '');
    derived names = started.map((outcome) => ({ en: outcome.en.trim(), fa: outcome.fa.trim(), icon: outcome.icon.trim() }));
    derived halfFilled = names.some((outcome) => outcome.en === '');

    derived lockSeconds = draft.lockAt() === '' ? 0 : Math.floor(new Date(draft.lockAt()).getTime() / 1000);
    derived resolveSeconds = draft.resolveAt() === '' ? 0 : Math.floor(new Date(draft.resolveAt()).getTime() / 1000);

    derived imageValid = draft.imageURI().trim() === '' || /^https:\/\/\S+$/.test(draft.imageURI().trim());
    derived feeValid = Number.isFinite(Number(draft.feeBps())) && Number(draft.feeBps()) >= 0 && Number(draft.feeBps()) <= FEE_MAX;
    derived shareValid = Number.isFinite(Number(draft.protocolShareBps())) && Number(draft.protocolShareBps()) >= 0 && Number(draft.protocolShareBps()) <= SHARE_MAX;

    // Per-step, so a missing English title never reports itself as an outcomes problem.
    const issueFor = (which: Step): string =>
    {
        if (which === 'question')
        {
            if (draft.titleEn().trim() === '') { return t('admin.validationTitle'); }
            if (draft.category().trim() === '') { return t('admin.validationCategory'); }
            if (!imageValid) { return t('admin.validationImage'); }
            return '';
        }
        if (which === 'outcomes')
        {
            if (halfFilled) { return t('admin.validationOutcomeEn'); }
            if (names.length < 2) { return t('admin.validationOutcomes'); }
            return '';
        }
        if (which === 'timing')
        {
            if (lockSeconds <= Math.floor(Date.now() / 1000) || resolveSeconds <= lockSeconds) { return t('admin.validationTiming'); }
            if (draft.liquidity().trim() === '' || !(Number(draft.liquidity()) > 0)) { return t('admin.validationLiquidity'); }
            if (!feeValid) { return t('admin.validationFee'); }
            if (!shareValid) { return t('admin.validationShare'); }
            return '';
        }
        return '';
    };

    derived issue = issueFor('question') || issueFor('outcomes') || issueFor('timing');
    derived stepIssue = issueFor(step);

    const submit = async (): Promise<void> =>
    {
        if (issue !== '')
        {
            return;
        }
        const result = await admin.create({
            title: encodeTitleMeta({ en: draft.titleEn().trim(), fa: draft.titleFa().trim(), emoji: draft.emoji().trim() }),
            description: encodeTextMeta({ en: draft.descriptionEn().trim(), fa: draft.descriptionFa().trim() }),
            category: draft.category().trim().toLowerCase(),
            imageURI: draft.imageURI().trim(),
            lockTime: lockSeconds,
            resolveTime: resolveSeconds,
            feeBps: Number(draft.feeBps()) || 0,
            protocolFeeShareBps: Number(draft.protocolShareBps()) || 0,
            outcomeNames: names.map((outcome) => (outcome.fa === '' && outcome.icon === '' ? outcome.en : encodeTextMeta(outcome))),
            initialLiquidity: parseEther(draft.liquidity())
        });
        if (result !== null)
        {
            // The transaction LANDED. Clear the draft even when the log did not parse, because
            // the market exists either way and a pre-filled form invites a duplicate deploy.
            created = { hash: result.hash, marketId: result.market?.marketId ?? null, address: result.market?.address ?? null };
            draft.reset();
        }
    };

    const again = (): void =>
    {
        created = null;
        step = 'question';
    };

    const mark = (): void =>
    {
        if (!visited.includes(step))
        {
            visited = [...visited, step];
        }
    };

    const advance = (): void =>
    {
        mark();
        const at = STEPS.indexOf(step);
        if (at < STEPS.length - 1)
        {
            step = STEPS[at + 1]!;
        }
    };

    const back = (): void =>
    {
        mark();
        const at = STEPS.indexOf(step);
        if (at > 0)
        {
            step = STEPS[at - 1]!;
        }
    };

    const FIELD = 'w-full rounded-control border border-line bg-raised px-3.5 text-[15px] text-text placeholder:text-faint transition-colors duration-200 focus:border-brand focus:outline-none';

    <Show
        when={ created === null }
        fallback={
            <Card class="mx-auto max-w-lg text-center">
                <span class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-yes-soft text-yes">
                    <Icon name="circle-check" size={ 24 } />
                </span>
                <p class="text-[17px] font-bold">{ t('admin.createdTitle') }</p>
                <p class="mt-1 text-[13px] text-muted">{ created?.address === null ? t('admin.createdUnparsed') : t('admin.createdHint') }</p>
                <p class="nums latin-nums mt-3 break-all text-[12px] text-faint" dir="ltr">{ created?.address ?? created?.hash ?? '' }</p>
                <div class="mt-4 flex justify-center gap-2">
                    <Show when={ explorerTxUrl(created?.hash ?? '') }>
                    { (url) =>
                        <a
                            class="flex h-10 items-center gap-1.5 rounded-control border border-line px-3.5 text-[14px] font-semibold text-muted transition-colors duration-200 hover:text-text"
                            href={ url() }
                            target="_blank"
                            rel="noreferrer"
                        >
                            <Icon name="external" size={ 15 } />
                            <span>{ t('chain.viewTx') }</span>
                        </a>
                    }
                    </Show>
                    <Button variant="primary" size="sm" icon="plus" onClick={ () => again() }>{ t('admin.create') }</Button>
                </div>
            </Card>
        }
    >
        <div class="mx-auto flex max-w-3xl flex-col gap-5">
            <nav class="rail rail-bleed gap-2" aria-label={ t('admin.createTitle') }>
                <For each={ STEPS } key={ (entry) => entry }>
                { (entry, index) =>
                    <button
                        class={ step === entry
                            ? 'flex h-10 shrink-0 cursor-pointer items-center gap-2 rounded-pill bg-brand px-4 text-[13px] font-bold text-on-brand'
                            : 'flex h-10 shrink-0 cursor-pointer items-center gap-2 rounded-pill border border-line px-4 text-[13px] font-semibold text-muted transition-colors duration-200 hover:text-text' }
                        type="button"
                        onClick={ () => { mark(); step = entry; } }
                    >
                        <span class="nums latin-nums opacity-60">{ index + 1 }</span>
                        <span>{ t(`admin.step${ entry }`) }</span>
                        <Show when={ entry !== 'review' && issueFor(entry) === '' }>
                            <Icon name="check" size={ 14 } />
                        </Show>
                    </button>
                }
                </For>
            </nav>

            <Card>
                <Show when={ step === 'question' }>
                    <div class="flex flex-col gap-3">
                        <Input label={ t('admin.formTitle') } placeholder={ t('admin.formTitle') } value={ draft.titleEn() } onInput={ (next) => draft.setTitleEn(next) } />
                        <Input label={ t('admin.formTitleFa') } placeholder={ t('admin.formTitleFa') } value={ draft.titleFa() } onInput={ (next) => draft.setTitleFa(next) } />

                        <div>
                            <p class="mb-1.5 text-[12px] font-semibold text-muted">{ t('admin.formEmoji') }</p>
                            <div class="flex flex-wrap gap-1.5">
                                <For each={ EMOJI } key={ (entry) => entry }>
                                { (entry) =>
                                    <button
                                        class={ draft.emoji() === entry
                                            ? 'flex h-10 w-10 cursor-pointer items-center justify-center rounded-control bg-brand-soft text-[19px] ring-1 ring-brand'
                                            : 'flex h-10 w-10 cursor-pointer items-center justify-center rounded-control bg-overlay text-[19px] transition-colors duration-200 hover:bg-raised' }
                                        type="button"
                                        aria-pressed={ draft.emoji() === entry }
                                        onClick={ () => draft.setEmoji(draft.emoji() === entry ? '' : entry) }
                                    >
                                        { entry }
                                    </button>
                                }
                                </For>
                            </div>
                        </div>

                        <textarea
                            class={ `${ FIELD } h-20 resize-none py-2.5` }
                            aria-label={ t('admin.formDescription') }
                            placeholder={ t('admin.formDescription') }
                            value={ draft.descriptionEn() }
                            onInput={ (event) => draft.setDescriptionEn((event.target as HTMLTextAreaElement).value) }
                        ></textarea>
                        <textarea
                            class={ `${ FIELD } h-20 resize-none py-2.5` }
                            aria-label={ t('admin.formDescriptionFa') }
                            placeholder={ t('admin.formDescriptionFa') }
                            value={ draft.descriptionFa() }
                            onInput={ (event) => draft.setDescriptionFa((event.target as HTMLTextAreaElement).value) }
                        ></textarea>

                        <div>
                            <Input label={ t('admin.formCategory') } placeholder={ t('admin.categoryHint') } value={ draft.category() } onInput={ (next) => draft.setCategory(next) } />
                            <Show when={ draft.category().trim() !== '' }>
                                <p class={ matched ? 'mt-1 text-[12px] text-faint' : 'mt-1 text-[12px] font-semibold text-gold' }>
                                    { matched ? t('admin.categoryMatched') : t('admin.categoryMinting') }
                                </p>
                            </Show>
                            <div class="mt-2 flex flex-wrap gap-1.5">
                                <For each={ suggestions } key={ (entry) => entry.id }>
                                { (entry) =>
                                    <Chip
                                        compact
                                        icon={ categoryIcon(entry.id) }
                                        selected={ draft.category().trim().toLowerCase() === entry.id }
                                        onSelect={ () => draft.setCategory(entry.id) }
                                    >
                                        { categories.label(entry.id) }
                                    </Chip>
                                }
                                </For>
                            </div>
                        </div>

                        <ImageField label={ t('admin.formImage') } value={ draft.imageURI() } onChange={ (uri) => draft.setImageURI(uri) } />
                    </div>
                </Show>

                <Show when={ step === 'outcomes' }>
                    <div class="flex flex-col gap-2.5">
                        <For each={ draft.outcomes() } key={ (outcome) => String(outcome.id) }>
                        { (outcome, index) =>
                            <div class="flex flex-col gap-2 rounded-card border border-line p-3">
                                <div class="flex items-center gap-2">
                                    <div class="grid flex-1 grid-cols-1 gap-2 sm:grid-cols-2">
                                        <Input label={ `${ t('admin.formOutcomes') } ${ index + 1 }` } placeholder="English" value={ outcome.en } onInput={ (next) => draft.setOutcome(outcome.id, 'en', next) } />
                                        <Input label={ `${ t('admin.formOutcomes') } ${ index + 1 } (fa)` } placeholder="فارسی" value={ outcome.fa } onInput={ (next) => draft.setOutcome(outcome.id, 'fa', next) } />
                                    </div>
                                    <Show when={ draft.outcomes().length > 2 }>
                                        <Tooltip label={ t('admin.removeOutcome') }>
                                            <button
                                                class="flex h-9 w-9 shrink-0 cursor-pointer items-center justify-center rounded-control text-muted transition-colors duration-200 hover:bg-no-soft hover:text-no"
                                                type="button"
                                                aria-label={ t('admin.removeOutcome') }
                                                onClick={ () => draft.removeOutcome(outcome.id) }
                                            >
                                                <Icon name="trash" size={ 16 } />
                                            </button>
                                        </Tooltip>
                                    </Show>
                                </div>
                                <ImageField label={ t('admin.outcomeIcon') } value={ outcome.icon } onChange={ (uri) => draft.setOutcome(outcome.id, 'icon', uri) } />
                            </div>
                        }
                        </For>
                        <Show when={ draft.outcomes().length < 16 }>
                            <Button variant="ghost" size="sm" icon="plus" onClick={ () => draft.addOutcome() }>{ t('admin.addOutcome') }</Button>
                        </Show>
                    </div>
                </Show>

                <Show when={ step === 'timing' }>
                    <div class="flex flex-col gap-3">
                        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                            <div>
                                <p class="mb-1 text-[12px] font-semibold text-muted">{ t('admin.formLock') }</p>
                                <Input type="datetime-local" label={ t('admin.formLock') } value={ draft.lockAt() } onInput={ (next) => draft.setLockAt(next) } />
                            </div>
                            <div>
                                <p class="mb-1 text-[12px] font-semibold text-muted">{ t('admin.formResolve') }</p>
                                <Input type="datetime-local" label={ t('admin.formResolve') } value={ draft.resolveAt() } onInput={ (next) => draft.setResolveAt(next) } />
                            </div>
                        </div>
                        <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
                            <div>
                                <p class="mb-1 text-[12px] font-semibold text-muted">{ t('admin.formLiquidity') } ({ chain.nativeCurrency.symbol })</p>
                                <Input type="number" label={ t('admin.formLiquidity') } placeholder="100" value={ draft.liquidity() } onInput={ (next) => draft.setLiquidity(next) } />
                            </div>
                            <div>
                                <p class="mb-1 text-[12px] font-semibold text-muted">{ t('admin.formFee') }</p>
                                <Input type="number" label={ t('admin.formFee') } value={ draft.feeBps() } onInput={ (next) => draft.setFeeBps(next) } />
                            </div>
                            <div>
                                <p class="mb-1 text-[12px] font-semibold text-muted">{ t('admin.formProtocolShare') }</p>
                                <Input type="number" label={ t('admin.formProtocolShare') } value={ draft.protocolShareBps() } onInput={ (next) => draft.setProtocolShareBps(next) } />
                            </div>
                        </div>
                        <p class="text-[12px] text-faint">{ t('admin.inheritHint') }</p>
                    </div>
                </Show>

                <Show when={ step === 'review' }>
                    <div class="flex flex-col gap-3">
                        <div class="flex items-start gap-3 rounded-card border border-line p-3.5">
                            <span class="flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-control bg-overlay text-[21px]">
                                <Show when={ draft.imageURI().trim() !== '' } fallback={ <span>{ draft.emoji() === '' ? '?' : draft.emoji() }</span> }>
                                    <img class="h-full w-full object-cover" src={ draft.imageURI().trim() } alt="" />
                                </Show>
                            </span>
                            <div class="min-w-0 flex-1">
                                <p class="text-[15px] font-bold leading-snug">{ draft.titleEn().trim() }</p>
                                <p class="text-[13px] text-muted" dir="rtl">{ draft.titleFa().trim() }</p>
                            </div>
                        </div>
                        <div class="flex flex-wrap gap-1.5">
                            <For each={ names } key={ (outcome) => outcome.en }>
                            { (outcome) =>
                                <span class="rounded-pill bg-overlay px-3 py-1 text-[13px] font-semibold">{ outcome.en }{ outcome.fa === '' ? '' : ` / ${ outcome.fa }` }</span>
                            }
                            </For>
                        </div>
                        <dl class="grid grid-cols-2 gap-2 text-[13px]">
                            <div class="flex justify-between gap-2"><dt class="text-muted">{ t('admin.formCategory') }</dt><dd class="font-semibold">{ draft.category().trim().toLowerCase() }</dd></div>
                            <div class="flex justify-between gap-2"><dt class="text-muted">{ t('admin.formLiquidity') }</dt><dd class="nums latin-nums font-semibold" dir="ltr">{ draft.liquidity() } { chain.nativeCurrency.symbol }</dd></div>
                            <div class="flex justify-between gap-2"><dt class="text-muted">{ t('admin.formFee') }</dt><dd class="nums latin-nums font-semibold" dir="ltr">{ draft.feeBps() }</dd></div>
                            <div class="flex justify-between gap-2"><dt class="text-muted">{ t('admin.formProtocolShare') }</dt><dd class="nums latin-nums font-semibold" dir="ltr">{ draft.protocolShareBps() }</dd></div>
                        </dl>
                    </div>
                </Show>

                <Show when={ stepIssue !== '' && visited.includes(step) }>
                    <p class="mt-3 text-[13px] font-semibold text-no">{ stepIssue }</p>
                </Show>
                <Show when={ step === 'review' && issue !== '' }>
                    <p class="mt-3 text-[13px] font-semibold text-no">{ issue }</p>
                </Show>

                <div class="mt-4 flex items-center justify-between gap-2 border-t border-line pt-4">
                    <Button variant="ghost" size="sm" icon="arrow-left" disabled={ step === 'question' } onClick={ () => back() }>{ t('common.back') }</Button>
                    <Show
                        when={ step === 'review' }
                        fallback={ <Button variant="outline" size="sm" disabled={ stepIssue !== '' } onClick={ () => advance() }>{ t('common.next') }</Button> }
                    >
                        <Button
                            variant="primary"
                            icon="sparkles"
                            disabled={ issue !== '' || onchain.pending() }
                            loading={ onchain.busy('create') }
                            onClick={ () => void submit() }
                        >
                            { t('admin.submitCreate') }
                        </Button>
                    </Show>
                </div>
            </Card>
        </div>
    </Show>
}
