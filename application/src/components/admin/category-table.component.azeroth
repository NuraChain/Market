import type { CategoryCount } from '../../api.ts';

import { useLocale } from '../../stores/locale.store.ts';
import { useAdmin } from '../../stores/admin.store.ts';
import { useCategories } from '../../stores/categories.store.ts';
import { useToasts } from '../../stores/toasts.store.ts';

import ImageField from './image-field.component.azeroth';

import Button from '../ui/button.component.azeroth';
import Card from '../ui/card.component.azeroth';
import Icon from '../../icons/icon.component.azeroth';
import Input from '../ui/input.component.azeroth';
import EmptyState from '../ui/empty-state.component.azeroth';
import Skeleton from '../ui/skeleton.component.azeroth';

const ID_PATTERN = /^[a-z0-9]+(?:-[a-z0-9]+)*$/;

// Categories are the one part of a market that is legitimately off-chain. The ID rides
// on-chain inside every market that carries it, so it is permanent; the label, image and
// order are ours to edit. Registering one here also lets a category exist BEFORE its first
// market, which the derived GROUP BY it replaced could never do.
export default component CategoryTable()
{
    const { t, lang } = useLocale();
    const admin = useAdmin();
    const categories = useCategories();
    const toasts = useToasts();

    state editing = '';
    state labelEn = '';
    state labelFa = '';
    state image = '';
    state sortOrder = '0';
    state saving = '';

    derived rows = categories.list.data() ?? [];
    derived taken = rows.some((row) => row.id === editing.trim().toLowerCase());
    derived idValid = ID_PATTERN.test(editing.trim().toLowerCase());
    derived isNew = editing !== '' && !taken;

    const open = (row: CategoryCount): void =>
    {
        editing = row.id;
        labelEn = row.labelEn;
        labelFa = row.labelFa;
        image = row.image;
        sortOrder = '0';
    };

    const reset = (): void =>
    {
        editing = '';
        labelEn = '';
        labelFa = '';
        image = '';
        sortOrder = '0';
    };

    const save = async (row: CategoryCount | null): Promise<void> =>
    {
        const id = (row?.id ?? editing).trim().toLowerCase();
        if (id === '' || !ID_PATTERN.test(id))
        {
            toasts.push('error', t('admin.categoryIdInvalid'), 'alert');
            return;
        }
        saving = id;
        const ok = await admin.saveCategory({
            id,
            labelEn: row === null ? labelEn.trim() : row.labelEn,
            labelFa: row === null ? labelFa.trim() : row.labelFa,
            image: row === null ? image.trim() : row.image,
            sortOrder: row === null ? Number(sortOrder) || 0 : 0,
            retired: row === null ? false : !row.retired
        });
        saving = '';
        if (ok)
        {
            toasts.push('success', t('admin.categorySaved'), 'check');
            if (row === null)
            {
                reset();
            }
        }
    };

    const label = (row: CategoryCount): string =>
    {
        const chosen = lang() === 'fa' ? row.labelFa : row.labelEn;
        return chosen === '' ? row.id : chosen;
    };

    <Card>
        <h2 class="text-lg font-bold tracking-tight">{ t('admin.categoriesTitle') }</h2>
        <p class="mb-4 mt-1 text-[13px] leading-relaxed text-muted">{ t('admin.categoriesHint') }</p>

        <div class="mb-5 flex flex-col gap-2.5 rounded-card border border-line bg-overlay/40 p-3.5">
            <div class="flex flex-col gap-2.5 sm:flex-row">
                <div class="flex-1">
                    <Input label={ t('admin.categoryId') } placeholder="iran-football" value={ editing } onInput={ (next) => editing = next } />
                </div>
                <div class="flex-1">
                    <Input label={ t('admin.categoryLabelEn') } placeholder="Iran football" value={ labelEn } onInput={ (next) => labelEn = next } />
                </div>
                <div class="flex-1">
                    <Input label={ t('admin.categoryLabelFa') } placeholder="فوتبال ایران" value={ labelFa } onInput={ (next) => labelFa = next } />
                </div>
            </div>
            <div class="flex flex-col gap-2.5 sm:flex-row sm:items-end">
                <div class="flex-1">
                    <ImageField label={ t('admin.categoryImage') } value={ image } onChange={ (uri) => image = uri } />
                </div>
                <div class="w-full sm:w-24">
                    <Input type="number" label={ t('admin.categorySort') } placeholder="0" value={ sortOrder } onInput={ (next) => sortOrder = next } />
                </div>
                <Button
                    variant="primary"
                    size="sm"
                    icon={ isNew ? 'plus' : 'check' }
                    disabled={ editing === '' || !idValid }
                    loading={ saving !== '' && saving === editing.trim().toLowerCase() }
                    onClick={ () => void save(null) }
                >
                    { isNew ? t('admin.categoryNew') : t('admin.categorySave') }
                </Button>
            </div>
            <Show when={ editing !== '' && !idValid }>
                <p class="text-[12px] font-semibold text-danger">{ t('admin.categoryIdInvalid') }</p>
            </Show>
            <Show when={ idValid && taken }>
                <p class="text-[12px] text-faint">{ t('admin.categoryIdHint') }</p>
            </Show>
        </div>

        <Show when={ categories.list.data() === undefined }>
            <Skeleton class="h-40 rounded-control" />
        </Show>

        <Show when={ categories.list.data() !== undefined && rows.length === 0 }>
            <EmptyState icon="tag" title={ t('admin.categoryEmpty') } hint={ t('admin.categoryEmptyHint') } />
        </Show>

        <div class="flex flex-col divide-y divide-line">
            <For each={ rows } key={ (row) => row.id }>
            { (row) =>
                <div class="flex items-center gap-3 py-2.5">
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-control bg-overlay">
                        <Show
                            when={ row.image !== '' }
                            fallback={ <Icon name="tag" size={ 16 } class="text-faint" /> }
                        >
                            <img class="h-full w-full object-cover" src={ row.image } alt="" loading="lazy" />
                        </Show>
                    </span>
                    <div class="min-w-0 flex-1">
                        <p class="truncate text-[14px] font-bold">{ label(row) }</p>
                        <p class="nums truncate text-[12px] text-faint" dir="ltr">{ row.id }</p>
                    </div>
                    <span class="nums shrink-0 text-[12px] text-muted">{ row.count } { t('admin.categoryMarkets') }</span>
                    <Show when={ row.retired }>
                        <span class="shrink-0 rounded-pill bg-overlay px-2 py-0.5 text-[11px] font-bold text-faint">{ t('admin.categoryRetired') }</span>
                    </Show>
                    <Button variant="ghost" size="sm" icon="edit" onClick={ () => open(row) } />
                    <Button
                        variant="ghost"
                        size="sm"
                        loading={ saving === row.id }
                        onClick={ () => void save(row) }
                    >
                        { row.retired ? t('admin.categoryRestore') : t('admin.categoryRetire') }
                    </Button>
                </div>
            }
            </For>
        </div>
    </Card>
}
