import { createEffect } from 'azerothjs';

import type { AdminMarketRow } from '../../api.ts';

import { fetchMarketDetail } from '../../lib/admin.ts';

import { useLocale } from '../../stores/locale.store.ts';
import { usePreferences } from '../../stores/preferences.store.ts';
import { useAdmin } from '../../stores/admin.store.ts';
import { useOnchain } from '../../stores/onchain.store.ts';

import { formatOdds } from '../../i18n/format.ts';

import Icon from '../../icons/icon.component.azeroth';

import Sheet from '../ui/sheet.component.azeroth';
import Button from '../ui/button.component.azeroth';
import SkeletonList from '../ui/skeleton-list.component.azeroth';

// The resolution surface: pick a winner, confirm with a second explicit click, or void
// instead. Both paths are irreversible on-chain, so neither ever fires from one click.
export default component ResolveDialog(props: {
    market: AdminMarketRow | null;
    onClose: () => void;
})
{
    const { t, lang, text } = useLocale();
    const { oddsMode } = usePreferences();
    const admin = useAdmin();
    const onchain = useOnchain();

    state picked = -1;
    state arming: 'none' | 'resolve' | 'void' = 'none';

    resource detail = (address: string) =>
        fetchMarketDetail(address as `0x${ string }`, false)
        with { source: props.market === null ? false : props.market.address };

    createEffect(() =>
    {
        void props.market;
        picked = -1;
        arming = 'none';
    });

    // The confirm button NAMES the winner. It used to read only "Confirm resolve" while the
    // selection sat in a scrollable list above it - an irreversible payout decision confirmed
    // by a bare red button that never restated what was being decided.
    derived pickedName = (() => { const label = detail.data()?.outcomes[picked]?.label; return label === undefined ? '' : text(label); })();

    derived stillTrading = props.market?.status === 'open' || props.market?.status === 'paused';

    const resolve = async (): Promise<void> =>
    {
        if (props.market === null || picked < 0)
        {
            return;
        }
        if (await admin.resolve(Number(props.market.id), picked))
        {
            props.onClose();
            return;
        }
        arming = 'none';
    };

    const voidOut = async (): Promise<void> =>
    {
        if (props.market === null)
        {
            return;
        }
        if (await admin.voidOut(Number(props.market.id)))
        {
            props.onClose();
            return;
        }
        arming = 'none';
    };

    <Sheet open={ props.market !== null } title={ t('admin.resolveTitle') } onClose={ () => props.onClose() }>
        <div class="flex flex-col gap-4">
            <div>
                <p class="text-[14px] font-bold">{ props.market === null ? '' : text(props.market.title) }</p>
                <p class="mt-1 text-[13px] text-muted">{ t('admin.resolveHint') }</p>
            </div>

            <Show when={ stillTrading }>
                <p class="flex items-start gap-2 rounded-control bg-gold-soft p-3 text-[13px] font-semibold leading-relaxed text-gold">
                    <Icon name="alert" size={ 15 } class="mt-0.5 shrink-0" />
                    <span>{ t('admin.resolveWhileOpen') }</span>
                </p>
            </Show>

            <Show when={ detail.loading() }>
                <SkeletonList count={ 2 } height="h-12" radius="control" />
            </Show>

            <Show when={ detail.data() } let={ data }>
                <ul class="flex flex-col gap-2" role="radiogroup" aria-label={ t('admin.outcomes') }>
                    <For each={ data.outcomes } key={ (outcome) => outcome.label.en } let={ outcome } index={ index }>
                        <li>
                            <button
                                class={ picked === index
                                            ? 'flex h-12 w-full cursor-pointer items-center gap-3 rounded-control border border-brand bg-brand-soft px-3 text-[14px] font-semibold text-text'
                                            : 'flex h-12 w-full cursor-pointer items-center gap-3 rounded-control border border-line bg-raised px-3 text-[14px] font-semibold text-muted transition-colors duration-200 hover:border-line-strong hover:text-text' }
                                type="button"
                                role="radio"
                                aria-checked={ picked === index ? 'true' : 'false' }
                                onClick={ () => { picked = index; arming = 'none'; } }
                            >
                                <span class="min-w-0 flex-1 truncate text-start">{ text(outcome.label) }</span>
                                <span class="nums latin-nums text-[13px] text-faint" dir="ltr">{ formatOdds(Number(outcome.price) / 1e18, lang(), oddsMode()) }</span>
                                <Show when={ picked === index }>
                                    <Icon name="circle-check" size={ 17 } class="text-brand" />
                                </Show>
                            </button>
                        </li>
                    </For>
                </ul>
            </Show>

            <Show
                when={ arming === 'resolve' }
                fallback={
                    <Button
                        variant="primary"
                        block
                        icon="gavel"
                        disabled={ picked < 0 || onchain.pending() }
                        onClick={ () => arming = 'resolve' }
                    >
                        { t('admin.resolveAction') }
                    </Button>
                }
            >
                <Button
                    variant="danger"
                    block
                    icon="alert"
                    disabled={ picked < 0 || onchain.pending() }
                    loading={ onchain.busy(`resolve:${ props.market?.id ?? '' }`) }
                    onClick={ () => void resolve() }
                >
                    { t('admin.confirmResolve') }: { pickedName }
                </Button>
            </Show>

            <div class="border-t border-line pt-3">
                <p class="mb-2 text-[12px] text-faint">{ t('admin.voidHint') }</p>
                <Show
                    when={ arming === 'void' }
                    fallback={
                        <Button variant="outline" size="sm" icon="circle-x" disabled={ onchain.pending() } onClick={ () => arming = 'void' }>
                            { t('admin.voidAction') }
                        </Button>
                    }
                >
                    <Button
                        variant="danger"
                        size="sm"
                        icon="alert"
                        disabled={ onchain.pending() }
                        loading={ onchain.busy(`void:${ props.market?.id ?? '' }`) }
                        onClick={ () => void voidOut() }
                    >
                        { t('admin.confirmVoid') }
                    </Button>
                </Show>
            </div>
        </div>
    </Sheet>
}
