import { createEffect } from 'azerothjs';

import { useLocale } from '../../stores/locale.store.ts';
import { useAdmin } from '../../stores/admin.store.ts';
import { useOnchain } from '../../stores/onchain.store.ts';
import { useConfig } from '../../stores/config.store.ts';

import Button from '../ui/button.component.azeroth';
import Card from '../ui/card.component.azeroth';
import Input from '../ui/input.component.azeroth';
import Skeleton from '../ui/skeleton.component.azeroth';

const FEE_MAX = 1000;
const SHARE_MAX = 10_000;

// The factory's defaults: the fee configuration new markets inherit, and the treasury
// address they are born pointing at. Applies to future markets only.
export default component ConfigCard()
{
    const { t } = useLocale();
    const admin = useAdmin();
    const onchain = useOnchain();
    const config = useConfig();

    state feeBps = '';
    state protocolShareBps = '';
    state treasury = '';

    // Re-seeds whenever the chain's own numbers change - after a saveFees the store's
    // defaults resource re-reads, and the fields must follow it rather than keep stale input.
    // A `seeded` latch used to block exactly that.
    let lastSeen = '';

    createEffect(() =>
    {
        const data = admin.defaults.data();
        if (data === undefined)
        {
            return;
        }
        const stamp = `${ data.defaultFeeBps }|${ data.defaultProtocolFeeShareBps }|${ config.data()?.treasury ?? '' }`;
        if (stamp !== lastSeen)
        {
            lastSeen = stamp;
            feeBps = String(data.defaultFeeBps);
            protocolShareBps = String(data.defaultProtocolFeeShareBps);
            treasury = config.data()?.treasury ?? '';
        }
    });

    derived feesValid = feeBps.trim() !== '' && protocolShareBps.trim() !== ''
        && Number.isFinite(Number(feeBps)) && Number(feeBps) >= 0 && Number(feeBps) <= FEE_MAX
        && Number.isFinite(Number(protocolShareBps)) && Number(protocolShareBps) >= 0 && Number(protocolShareBps) <= SHARE_MAX;

    state armed = false;

    const pointTreasury = async (): Promise<void> =>
    {
        armed = false;
        await admin.pointTreasury(treasury as `0x${ string }`);
    };

    <Card>
        <h2 class="mb-3 text-lg font-bold tracking-tight">{ t('admin.configTitle') }</h2>
        <Show when={ admin.defaults.data() === undefined }>
            <Skeleton class="h-24 rounded-control" />
        </Show>
        <Show when={ admin.defaults.data() }>
            { () =>
                <div class="flex flex-col gap-3">
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <p class="mb-1 text-[12px] font-semibold text-muted">{ t('admin.formFee') }</p>
                            <Input type="number" label={ t('admin.formFee') } value={ feeBps } onInput={ (next) => feeBps = next } />
                        </div>
                        <div>
                            <p class="mb-1 text-[12px] font-semibold text-muted">{ t('admin.formProtocolShare') }</p>
                            <Input type="number" label={ t('admin.formProtocolShare') } value={ protocolShareBps } onInput={ (next) => protocolShareBps = next } />
                        </div>
                    </div>
                    <Show when={ !feesValid && feeBps.trim() !== '' && protocolShareBps.trim() !== '' }>
                        <p class="text-[12px] font-semibold text-danger">{ t('admin.validationFee') }</p>
                    </Show>
                    <Button
                        variant="outline"
                        size="sm"
                        disabled={ !feesValid || onchain.pending() }
                        loading={ onchain.busy('saveFees') }
                        onClick={ () => void admin.saveFees(Number(feeBps), Number(protocolShareBps)) }
                    >
                        { t('admin.saveFees') }
                    </Button>

                    <div class="border-t border-line pt-3">
                        <p class="mb-1 text-[12px] font-semibold text-muted">{ t('admin.treasuryAddress') }</p>
                        <p class="mb-2 text-[12px] text-faint">{ t('admin.treasuryWarning') }</p>
                        <div class="flex items-center gap-2">
                            <div class="flex-1">
                                <Input label={ t('admin.treasuryAddress') } placeholder="0x" value={ treasury } onInput={ (next) => { treasury = next; armed = false; } } />
                            </div>
                            <Show
                                when={ armed }
                                fallback={
                                    <Button
                                        variant="outline"
                                        size="sm"
                                        disabled={ !/^0x[0-9a-fA-F]{40}$/.test(treasury) || treasury.toLowerCase() === (config.data()?.treasury ?? '').toLowerCase() || onchain.pending() }
                                        onClick={ () => armed = true }
                                    >
                                        { t('admin.updateTreasury') }
                                    </Button>
                                }
                            >
                                <Button
                                    variant="danger"
                                    size="sm"
                                    loading={ onchain.busy('pointTreasury') }
                                    onClick={ () => void pointTreasury() }
                                >
                                    { t('admin.confirmTreasury') }
                                </Button>
                            </Show>
                        </div>
                    </div>
                </div>
            }
        </Show>
    </Card>
}
