import type { MarketStatusName } from '../../api.ts';

import { fetchMarketDetail, shortEther } from '../../lib/admin.ts';
import { chain } from '../../lib/chain.ts';
import { copyText } from '../../lib/clipboard.ts';

import { useLocale } from '../../stores/locale.store.ts';
import { usePreferences } from '../../stores/preferences.store.ts';
import { useToasts } from '../../stores/toasts.store.ts';

import { formatOdds } from '../../i18n/format.ts';

import Icon from '../../icons/icon.component.azeroth';

import Badge from '../ui/badge.component.azeroth';
import SkeletonList from '../ui/skeleton-list.component.azeroth';

// The expanded strip under a market row: live per-outcome prices and reserves read from the
// clone itself (trustless), the clone address, and the fees this market sent the treasury.
export default component MarketRowDetail(props: {
    address: string;
    status: MarketStatusName;
    collected: number;
})
{
    const { t, lang, text } = useLocale();
    const { oddsMode } = usePreferences();
    const toasts = useToasts();

    resource detail = (address: string) =>
        fetchMarketDetail(address as `0x${ string }`, props.status === 'resolved')
        with { source: props.address };

    const copy = async (): Promise<void> =>
    {
        if (await copyText(props.address))
        {
            toasts.push('info', t('profile.copied'), 'copy');
            return;
        }
        toasts.push('error', t('toast.copyFailed'), 'alert');
    };

    <div class="border-t border-line pt-3">
        <Show when={ detail.loading() }>
            <SkeletonList count={ 2 } height="h-8" radius="control" />
        </Show>
        <Show when={ detail.data() }>
            { (data) =>
                <div class="flex flex-col gap-2">
                    <ul class="flex flex-col gap-1.5">
                        <For each={ data().outcomes } key={ (outcome) => outcome.label.en }>
                            { (outcome, index) =>
                                <li class="flex items-center gap-2 text-[13px]">
                                    <Show when={ data().winningOutcome === index }>
                                        <Icon name="trophy" size={ 14 } class="text-gold" />
                                    </Show>
                                    <span class="min-w-0 flex-1 truncate font-semibold">{ text(outcome.label) }</span>
                                    <span class="nums latin-nums text-muted" dir="ltr">{ formatOdds(Number(outcome.price) / 1e18, lang(), oddsMode()) }</span>
                                    <span class="nums latin-nums w-28 text-end text-faint" dir="ltr">{ shortEther(outcome.reserve) } { chain.nativeCurrency.symbol }</span>
                                </li>
                            }
                        </For>
                    </ul>
                    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[12px] text-faint">
                        <button class="nums latin-nums inline-flex min-w-0 cursor-pointer items-center gap-1.5 text-faint transition-colors duration-200 hover:text-text" type="button" aria-label={ t('common.copy') } onClick={ () => void copy() }>
                            <span class="truncate" dir="ltr">{ props.address }</span>
                            <Icon name="copy" size={ 13 } />
                        </button>
                        <Badge tone="gold">{ t('admin.collected') }: <span class="nums latin-nums" dir="ltr">{ props.collected.toFixed(4) } { chain.nativeCurrency.symbol }</span></Badge>
                    </div>
                </div>
            }
        </Show>
    </div>
}
