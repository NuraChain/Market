# Copy to .env for deploying against a live Cosmos EVM chain. Never commit .env.
# Read by hardhat.config.ts (dotenv) for the `cosmosEvm` network.

# JSON-RPC endpoint of the Cosmos EVM chain.
RPC_URL=https://evm-rpc.your-cosmos-evm-chain.example

# Deployer key (0x-prefixed). Use a throwaway key for testnets.
PRIVATE_KEY=

# EVM chain id of the target chain.
CHAIN_ID=9000

# Gas report toggle for `npm run test`.
REPORT_GAS=false
